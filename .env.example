# profitbots settings. Copy to .env (next to docker-compose.yml). NEVER commit .env.
# Only TYPESAFE_API_KEY is required for paper trading.

# ---- Mode -------------------------------------------------------------------
# dry  = PAPER TRADING (the default): real Coinbase market prices, simulated money, no exchange account needed
# live = REAL MONEY on Coinbase Derivatives. Needs DRY_RUN=false, MODE=live, Coinbase keys AND LIVE_ACK. Not financial advice.
MODE=dry
# Safety latch. true (the default, also when unset) forces paper trading whatever MODE says.
DRY_RUN=true
# Only for MODE=live: must be exactly I-ACCEPT-REAL-MONEY-RISK. You can lose everything you put in.
LIVE_ACK=

# ---- Jev (TypeSafe AI) ------------------------------------------------------
# Required. Key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=2000
# Hard daily Jev spend cap in USD. When hit, the agent holds what it has and opens nothing until 00:00 UTC.
JEV_DAILY_USD_CAP=2
# How often the agent asks Jev (ms). One call per tick covers every lens and every open position.
TICK_MS=10000
# Full market refresh (candles, indicators, funding, OI): every 60 s
DATA_REFRESH_MS=60000

# ---- Coinbase Derivatives (live only) -----------------------------------------
# Create a CDP API key at https://portal.cdp.coinbase.com/access/api with ONLY the "Trade" and "View" permissions.
# Never grant Transfer. Restrict it to your server's IP. The key name looks like
# organizations/<org-id>/apiKeys/<key-id>; the private key is the PEM (ECDSA) or base64 (Ed25519) string from the
# downloaded JSON. Paste the PEM on one line with \n for newlines, in double quotes.
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
# Optional: the portfolio UUID that holds your futures (CFM) account, if you have more than one.
COINBASE_PORTFOLIO_ID=
COINBASE_API_BASE=https://api.coinbase.com

# ---- Risk ---------------------------------------------------------------------
# Paper stake, and the equity the agent's P&L is measured from.
START_EQUITY_USD=1000
# Leverage on any single position, 1-10 (Coinbase Derivatives intraday max is 10x).
MAX_LEVERAGE=3
# Hard ceiling on gross open notional across every position, whatever the leverage math says.
MAX_TOTAL_NOTIONAL_USD=10000
# One position may use at most this fraction of the total notional budget.
MAX_POSITION_FRAC=0.5
# 0 = unlimited concurrent positions (capped by notional). Any other number is a hard count.
MAX_POSITIONS=0
# Daily loss stop, % of equity at 00:00 UTC. Trip = flatten everything and sit out until 00:00 UTC.
DAILY_LOSS_STOP_PCT=8
# If equity falls below this % of START_EQUITY_USD the agent retires for good.
RETIRE_AT_PCT=40
MAX_TRADES_PER_DAY=12
FEE_BUDGET_USD_DAY=25
SPREAD_GATE_BPS=10
COOLDOWN_MINUTES=3
STOP_ATR_MULT=2
# Jev must give an open at least this probability and conviction, or the agent stays flat.
MIN_OPEN_PROB=0.55
MIN_CONVICTION=1
# Scale size by realised edge (Kelly-lite) once there is enough closed-trade history.
EDGE_SIZING=true
# First hours of live trading run at reduced size
LIVE_SIZE_MULTIPLIER=0.25
LIVE_RAMP_HOURS=2
MIN_24H_VOL_USD=1000000
# Coinbase also lists gold/silver/oil/index futures. false = crypto only.
ALLOW_NON_CRYPTO=false
TAKER_FEE_RATE=0.0005
# Lenses: which coins the trend and breakout lenses watch; momentum scans the whole universe.
TREND_COINS=BTC,ETH
BREAKOUT_COINS=BTC,ETH,SOL,XRP
MOMENTUM_CANDIDATES=5

# ---- Server -------------------------------------------------------------------
# A domain pointed at this server gets automatic HTTPS. Blank = plain HTTP on the server's IP.
PUBLIC_DOMAIN=
LOG_LEVEL=info
# Alerts (optional): a Telegram bot, ntfy.sh topic or any webhook URL. Cap trips, Jev outages, restarts.
ALERT_WEBHOOK_URL=
# "Update available" on the dashboard when a newer GitHub Release is out. It never installs anything by itself.
UPDATE_CHECK=false
REPO_LINK=https://github.com/MatthewMastando/profitbots
