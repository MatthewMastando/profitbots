# profitbots: SITE_ADDRESS is PUBLIC_DOMAIN when set (Caddy gets the HTTPS certificate itself), otherwise :80 (plain HTTP on any address).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Optional: put the whole dashboard behind a password. Uncomment and paste a hash from
	#   docker run --rm caddy caddy hash-password
	# basic_auth {
	# 	me <hash>
	# }

	# Read-only engine endpoints. Only GET is proxied; the engine refuses everything else too.
	@api {
		method GET
		path /events /snapshot /history /equity /analytics /trades /health /profile
	}
	handle @api {
		reverse_proxy engine:8080 {
			# Server-sent events: never buffer.
			flush_interval -1
		}
	}

	# Static dashboard, built into the image. Hashed assets are immutable; index.html revalidates.
	handle {
		root * /srv/dashboard
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
	}
}
